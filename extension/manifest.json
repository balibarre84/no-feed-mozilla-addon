{
  "manifest_version": 2,
  "name": "No feed",
  "version": "1.0.0",
  "description": "Reddit : feeds, suggestions de recherche, boutons et barre latérale masqués. YouTube : feed d'accueil, barre latérale et Shorts masqués. Instagram : accueil, feed, Reels et grille Explorer masqués.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "css": [
        "reddit/hide.css"
      ],
      "js": [
        "reddit/subreddits.js",
        "reddit/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": [
        "youtube/hide.css"
      ],
      "js": [
        "youtube/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "css": [
        "instagram/hide.css"
      ],
      "js": [
        "instagram/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "no-feed@matisse.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/balibarre84/no-feed-mozilla-addon/main/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
